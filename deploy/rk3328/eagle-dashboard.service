# Starts the Eagle dashboard on the RK3328 HMI panel once Weston is up.
[Unit]
Description=Eagle scooter dashboard
After=weston.service
Wants=weston.service

[Service]
Environment=EAGLE_BOARD=1
Environment=QT_QPA_PLATFORM=wayland
Environment=QT_WAYLAND_DISABLE_WINDOWDECORATION=1
Environment=QT_QUICK_BACKEND=software
Environment=QT_IM_MODULE=qtvirtualkeyboard
Environment=XDG_RUNTIME_DIR=/run/user/0
# Wait for the compositor's socket rather than racing it.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 50); do [ -S /run/user/0/wayland-1 ] || [ -S /run/user/0/wayland-0 ] && exit 0; sleep 0.2; done; exit 1'
ExecStart=/opt/eagle/bin/EagleTheme --board --can can0
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
